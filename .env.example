# Токен бота от @BotFather
BOT_TOKEN=
# Имя бота без @ (для входа через Telegram Login Widget в веб-версии)
BOT_USERNAME=
# Публичный HTTPS-адрес, где открыт веб-клиент (Mini App). Без https Telegram его не откроет.
WEBAPP_URL=https://booking.example.com

PORT=3000
# В docker-compose задаётся автоматически. Для запуска без Docker:
DATABASE_URL=postgres://booking:booking@localhost:5432/booking
# Пароль БД для docker-compose
POSTGRES_PASSWORD=booking

# webhook — продакшен (Telegram сам шлёт апдейты на WEBAPP_URL/telegram/webhook),
# polling — локальная разработка без публичного адреса (только одна копия приложения!)
BOT_MODE=webhook
# 16–256 символов: A-Z a-z 0-9 _ -   Сгенерировать: openssl rand -hex 32
WEBHOOK_SECRET=
# Случайная строка от 32 символов: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Telegram ID администраторов через запятую (узнать свой — @userinfobot)
ADMIN_TG_IDS=
# Куда слать новые записи: ID рабочей группы (бот должен быть в ней). Пусто — в личку каждому админу.
ADMIN_CHAT_ID=

TIMEZONE=Europe/Moscow
# Часы работы: вс,пн,вт,ср,чт,пт,сб. «-» — выходной.
WORKING_HOURS=-,09:00-20:00,09:00-20:00,09:00-20:00,09:00-20:00,09:00-20:00,10:00-16:00
SLOT_STEP_MIN=30
MIN_LEAD_MIN=60
HORIZON_DAYS=14

SERVICE_NAME=Автосервис
SERVICE_ADDRESS=
SERVICE_PHONE=

# Только для локальной разработки: вход без Telegram. В проде — 0 или удалить.
DEV_LOGIN=0
